# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# yt-dlp cookies must never be committed
cookies.txt
backend/cookies.txt
backend/.yt-dlp-cookies.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Media backend (Python virtualenv + downloaded media cache)
backend/.venv/
backend/bin/
backend/downloads

# python
__pycache__/
*.py[cod]
.venv/
