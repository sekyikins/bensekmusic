# Port the media server will run on (Render injects this automatically)
PORT=3001

# Public base URL for the media server (used in the media links returned to clients).
# In production set this to your public URL, e.g.
#   BASE_URL=https://bensekmusic.onrender.com
# If left unset on Render, RENDER_EXTERNAL_URL is used automatically.
BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# YouTube on cloud/datacenter hosts (Render, Railway, Fly, ...)
# YouTube frequently blocks these IPs with "Sign in to confirm you're not a bot".
# Provide ONE of the following so yt-dlp can authenticate:
#
# 1) Cookies from a browser that is logged into YouTube.
#    Export with a "Get cookies.txt LOCALLY" extension, or:
#      yt-dlp --cookies-from-browser chrome --cookies cookies.txt
#    Then either:
#      a) paste the whole file contents (or its base64) here:
#         YTDLP_COOKIES=
#      b) or point at a file on the server:
#         YTDLP_COOKIES_PATH=/etc/secrets/cookies.txt
#
# 2) Route yt-dlp through a proxy (residential proxies work best):
#      YTDLP_PROXY=http://user:pass@host:port
# ---------------------------------------------------------------------------
# YTDLP_COOKIES=
# YTDLP_COOKIES_PATH=
# YTDLP_PROXY=
