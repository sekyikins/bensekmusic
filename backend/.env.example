# Port the media server runs on (Render injects this automatically; local default 3001)
PORT=3001

# Public base URL for the media server (used to build the media links returned
# to clients). In production set this to your public URL, e.g.
#   BASE_URL=https://bensekmusic.onrender.com
# If left unset on Render, RENDER_EXTERNAL_URL is used automatically.
BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# YouTube on cloud/datacenter hosts (Render, Railway, Fly, ...)
# YouTube frequently blocks these IPs with "Sign in to confirm you're not a bot".
# Provide ONE of the cookie options so yt-dlp can authenticate:
#
# 1) YTDLP_COOKIES      -> the whole cookies.txt contents (raw or base64)
# 2) YTDLP_COOKIES_PATH -> absolute path to a cookies.txt file on the server
# 3) a file at backend/cookies.txt (picked up automatically)
#
# Export cookies with the Python yt-dlp:
#   yt-dlp --cookies-from-browser firefox --cookies cookies.txt
#
# Optionally route yt-dlp through a proxy (residential proxies work best):
#   YTDLP_PROXY=http://user:pass@host:port
#
# A JavaScript runtime is required to solve YouTube's challenges. It defaults
# to the `deno` binary bundled by the `deno` PyPI package; set this to "node"
# only if you'd rather use Node.js.
# ---------------------------------------------------------------------------
# YTDLP_COOKIES=
# YTDLP_COOKIES_PATH=
# YTDLP_PROXY=
# YTDLP_JS_RUNTIMES=deno
