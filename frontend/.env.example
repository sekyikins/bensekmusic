# Base URL of the media server (hosted on Render).
# All yt-dlp processing happens there; the Next.js app only proxies to it.
# Local development:
NEXT_PUBLIC_MEDIA_SERVER_URL=http://localhost:3001
# Production (set in the Vercel dashboard):
# NEXT_PUBLIC_MEDIA_SERVER_URL=https://sekmusic-media-server.onrender.com
